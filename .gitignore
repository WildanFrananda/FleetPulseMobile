# -------------------------------------------------------------------------
# Flutter / Dart / Pub Dependencies and Build Artifacts
# -------------------------------------------------------------------------
# Absolute build directory
/build/

# Ephemeral Dart, Pub, and Flutter tool caches and logs
.dart_tool/
.flutter-plugins
.flutter-plugins-dependencies
.packages
.pub-cache/
.pub/

# Avoid ignoring the pubspec.lock unless testing a monorepo locally
# !pubspec.lock

# Style guide documentation generated by dartdoc
**/doc/api/

# -------------------------------------------------------------------------
# Android Specifics
# -------------------------------------------------------------------------
**/android/local.properties
**/android/captures/
**/android/.gradle/
**/android/**/GeneratedPluginRegistrant.java

# Keystore files containing signing secrets
*.keystore
*.jks

# -------------------------------------------------------------------------
# iOS/macOS Specifics
# -------------------------------------------------------------------------
**/ios/Flutter/GeneratedPluginRegistrant.h
**/ios/Flutter/GeneratedPluginRegistrant.m
**/ios/Flutter/flutter_export_environment.sh
**/ios/Flutter/ephemeral/
**/ios/.symlinks/
**/ios/Pods/

# macOS system files
.DS_Store

# -------------------------------------------------------------------------
# Web Specifics
# -------------------------------------------------------------------------
/web/manifest.json.tmp

# -------------------------------------------------------------------------
# Development Tools and IDEs
# -------------------------------------------------------------------------
# Visual Studio Code
.vscode/

# IntelliJ / Android Studio
*.iml
*.ipr
*.iws
.idea/

# -------------------------------------------------------------------------
# Application Secrets and Environments
# -------------------------------------------------------------------------
.env
.env.*
!*.example

# FVM Version Cache
.fvm/